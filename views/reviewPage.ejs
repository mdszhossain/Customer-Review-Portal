<%- layout("./layout/boilerplate.ejs") %>
<%- include("./includes/navbar.ejs") %>
<!-- Review Nav Section -->
<section class="bg-[#FFFAF7] h-screen">
    <section class="review-page-nav bg-white shadow">
        <div class="w-11/12 m-auto flex justify-between items-center pr-6">
            <div class="review-nav-left flex items-center p-6 gap-5">
                <form action="/crp/adminPanel" method="GET"><button class="py-2 px-4 bg-[#E85D26] rounded-xl text-white"><i class="fa-solid fa-arrow-left"></i> Back</button></form>
                <div>
                    <p class="text-xl font-bold"><%= shop.shopname %></p>
                    <p class="text-sm"><%= shop.shoplocation %></p>
                </div>
            </div>
            <form action="/crp/<%= shop._id %>/qrcode" method="GET"><button class="py-2 px-4 bg-[#E85D26] text-white rounded-xl"><i class="fa-solid fa-qrcode"></i> Generate QR Code</button></form>
        </div>
    </section>

    <!-- Total Review Section -->
    <section class="w-11/12 m-auto mt-5 grid grid-cols-2 gap-5 px-6">
        <div class="h-30 rounded-xl bg-white shadow p-4 flex items-center">
            <div>
                <p class="text-xl font-bold">Total Reviews</p>
                <p class="text-2xl font-bold"><%= totalReviews %></p>
            </div>
        </div>
        <div class="h-30 rounded-xl bg-white shadow p-4 flex items-center">
            <div>
                <p class="text-xl font-bold">Average Ratings</p>
                <p class="text-2xl font-bold"><%= averageRating.toFixed(1) %></p>
            </div>
        </div>
    </section>

    <!-- reviews section -->
    <section class="w-11/12 m-auto mt-5 gap-5 px-6 grid grid-cols-3">
        <div class="bg-[#FFF1F2] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>1-3 stars</p>
                <p class="p-2 bg-[#FFE4E6] text-red-500 h-7 w-7 flex items-center justify-center rounded-full"><%= reviews1To3.length %></p>
            </div>

            <% for (let review of reviews1To3) { %>
                <div class="p-4 bg-white rounded-xl mt-5 shadow">
                    <div class="flex justify-between items-center">
                        <div>
                            <p>Name: <%= review.customerName %></p>
                            <p>Phone: <%= review.phone %></p>
                        </div>
                        <div>
                            <div class="rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <input
                                        type="radio"
                                        value="<%= i %>"
                                        name="review-star-<%= review._id %>"
                                        class="mask mask-star-2 bg-orange-400 w-4 h-4"
                                        aria-label="<%= i %> star"
                                        <%= review.star === i ? "checked" : "" %>
                                        disabled
                                    />
                                <% } %>
                            </div>
                            <p><%= review.star %> / 5</p>
                        </div>
                    </div>
                    <p class="mt-5"><%= review.message %></p>
                </div>
            <% } %>
        </div>
        <div class="bg-[#FFFBEB] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>4 stars</p>
                <p class="p-2 bg-[#FEF3C6] text-[#E17120] h-7 w-7 flex items-center justify-center rounded-full"><%= reviews4.length %></p>
            </div>
            <!-- invidual review -->
            <% for(let review of reviews4) {%>
                <div class="p-4 bg-white rounded-xl mt-5 shadow">
                    <div class="flex justify-between items-center">
                        <div>
                            <p>Name: <%= review.customerName %></p>
                            <p>Phone: <%= review.phone %></p>
                        </div>
                        <div>
                            <div class="rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                        <input
                                            type="radio"
                                            value="<%= i %>"
                                            name="review-star-<%= review._id %>"
                                            class="mask mask-star-2 bg-orange-400 w-4 h-4"
                                            aria-label="<%= i %> star"
                                            <%= review.star === i ? "checked" : "" %>
                                            disabled
                                        />
                                    <% } %>
                            </div>
                            <p><%= review.star %> / 5</p>
                        </div>
                    </div>
                    <p class="mt-5"><%= review.message %></p>
                </div>
            <% } %>
        </div>
        <div class="bg-[#ECFDF5] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>5 stars</p>
                <p class="p-2 bg-[#D0FAE5] text-[#007A88] h-7 w-7 flex items-center justify-center rounded-full"><%= reviews5.length %></p>
            </div>
            <!-- invidual review -->
            <% for(let review of reviews5) {%>
                <div class="p-4 bg-white rounded-xl mt-5 shadow">
                    <div class="flex justify-between items-center">
                        <div>
                            <p>Name: <%= review.customerName %></p>
                            <p>Phone: <%= review.phone %></p>
                        </div>
                        <div>
                            <div class="rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                        <input
                                            type="radio"
                                            value="<%= i %>"
                                            name="review-star-<%= review._id %>"
                                            class="mask mask-star-2 bg-orange-400 w-4 h-4"
                                            aria-label="<%= i %> star"
                                            <%= review.star === i ? "checked" : "" %>
                                            disabled
                                        />
                                    <% } %>
                            </div>
                            <p><%= review.star %> / 5</p>
                        </div>
                    </div>
                    <p class="mt-5"><%= review.message %></p>
                </div>
            <% } %>
    </section>
</section>