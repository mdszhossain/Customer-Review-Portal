<%- layout("./layout/boilerplate.ejs") %>
<%- include("./includes/navbar.ejs") %>
<!-- Review Nav Section -->
<section class="bg-[#FFFAF7] h-screen">
    <section class="review-page-nav bg-white shadow">
        <div class="w-11/12 m-auto flex justify-between items-center pr-6">
            <div class="review-nav-left flex items-center p-6 gap-5">
                <form action="/crp/adminPanel" method="GET"><button class="py-2 px-4 bg-[#E85D26] rounded-xl text-white"><i class="fa-solid fa-arrow-left"></i> Back</button></form>
                <div>
                    <p class="text-xl font-bold"><%= shop.shopname %></p>
                    <p class="text-sm"><%= shop.shoplocation %></p>
                </div>
            </div>
            <form action=""><button class="py-2 px-4 bg-[#E85D26] text-white rounded-xl"><i class="fa-solid fa-qrcode"></i> Generate QR Code</button></form>
        </div>
    </section>

    <!-- Total Review Section -->
    <section class="w-11/12 m-auto mt-5 grid grid-cols-2 gap-5 px-6">
        <div class="h-30 rounded-xl bg-white shadow p-4 flex items-center">
            <div>
                <p class="text-xl font-bold">Total Reviews</p>
                <p class="text-2xl font-bold">4</p>
            </div>
        </div>
        <div class="h-30 rounded-xl bg-white shadow p-4 flex items-center">
            <div>
                <p class="text-xl font-bold">Average Ratings</p>
                <p class="text-2xl font-bold">4.8</p>
            </div>
        </div>
    </section>

    <!-- reviews section -->
    <section class="w-11/12 m-auto mt-5 gap-5 px-6 grid grid-cols-3">
        <div class="bg-[#FFF1F2] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>1-3 stars</p>
                <p class="p-2 bg-[#FFE4E6] text-red-500 h-7 w-7 flex items-center justify-center rounded-full">1</p>
            </div>
            <!-- invidual review -->
            <div class="p-4 bg-white rounded-xl mt-5 shadow">
                <div class="flex justify-between items-center">
                    <div>
                        <p>Reviewer Name</p>
                        <p>Review Date</p>
                    </div>
                    <div>
                        <div class="rating mt-5">
                            <input type="radio" value="1" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="1 star" checked="checked"/>
                            <input type="radio" value="2" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="2 star" />
                            <input type="radio" value="3" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="3 star" />
                            <input type="radio" value="4" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="4 star" />
                            <input type="radio" value="5" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="5 star" />
                        </div>
                        <p>Review-Star</p>
                    </div>
                </div>
                <p>Review-Feedback-Sentence</p>
            </div>
        </div>
        <div class="bg-[#FFFBEB] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>4 stars</p>
                <p class="p-2 bg-[#FEF3C6] text-[#E17120] h-7 w-7 flex items-center justify-center rounded-full">1</p>
            </div>
            <!-- invidual review -->
            <div class="p-4 bg-white rounded-xl mt-5 shadow">
                <div class="flex justify-between items-center">
                    <div>
                        <p>Reviewer Name</p>
                        <p>Review Date</p>
                    </div>
                    <div>
                        <div class="rating mt-5">
                            <input type="radio" value="1" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="1 star" checked="checked"/>
                            <input type="radio" value="2" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="2 star" />
                            <input type="radio" value="3" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="3 star" />
                            <input type="radio" value="4" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="4 star" />
                            <input type="radio" value="5" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="5 star" />
                        </div>
                        <p>Review-Star</p>
                    </div>
                </div>
                <p>Review-Feedback-Sentence</p>
            </div>
        </div>
        <div class="bg-[#ECFDF5] p-4 rounded-xl shadow">
            <div class="flex items-center justify-between">
                <p>5 stars</p>
                <p class="p-2 bg-[#D0FAE5] text-[#007A88] h-7 w-7 flex items-center justify-center rounded-full">1</p>
            </div>
            <!-- invidual review -->
            <div class="p-4 bg-white rounded-xl mt-5 shadow">
                <div class="flex justify-between items-center">
                    <div>
                        <p>Reviewer Name</p>
                        <p>Review Date</p>
                    </div>
                    <div>
                        <div class="rating mt-5">
                            <input type="radio" value="1" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="1 star" checked="checked"/>
                            <input type="radio" value="2" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="2 star" />
                            <input type="radio" value="3" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="3 star" />
                            <input type="radio" value="4" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="4 star" />
                            <input type="radio" value="5" name="star" class="mask mask-star-2 bg-orange-400 w-4 h-4" aria-label="5 star" />
                        </div>
                        <p>Review-Star</p>
                    </div>
                </div>
                <p>Review-Feedback-Sentence</p>
            </div>
        </div>
    </section>
</section>