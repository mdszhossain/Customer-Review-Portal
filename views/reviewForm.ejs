<%- layout("./layout/boilerplate.ejs") %>
<section>
    <div class="flex bg-[#341C13] justify-between items-center">
        <div class="p-4 form-nav-logo bg-[#341C13] text-white text-2xl font-bold"><i class="fa-brands fa-yelp"></i>C-R-P</div>
        <div class="text-white text-xl p-4">Contact Manager: +8801766032333</div>
    </div>
    <div class="h-screen bg-[#341C13] flex justify-center items-center">
        <form action="" class="h-150 w-150 bg-[#FFFAF7] rounded-2xl">
            <div class="review-star-box text-center p-5 bg-[#FEF4EE] rounded-2xl">
                <h4>Rate your overall experience</h4>
                <div class="rating mt-5">
                    <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400 w-8 h-8" aria-label="1 star" />
                    <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400 w-8 h-8" aria-label="2 star" checked="checked" />
                    <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400 w-8 h-8" aria-label="3 star" />
                    <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400 w-8 h-8" aria-label="4 star" />
                    <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400 w-8 h-8" aria-label="5 star" />
                </div>
            </div>
            <div class="px-10 mt-5">
                <label class=" text-center" for="feedback">Your Feedback</label>
                <textarea class="feedback-box mt-5 w-full rounded-xl p-3 bg-[#F9F5F2]" name="" id="feedback" rows="5" placeholder="Tell us about your experience"></textarea>
            </div>
            <div class="px-10 flex justify-between items-center mt-5">
                <div>
                    <label for="name">Name</label><br>
                    <input class="p-3 rounded-xl bg-[#F9F5F2] input-bg" type="text" placeholder="Enter your name">
                </div>
                <div>
                    <label for="phone">Phone</label><br>
                    <input class="p-3 rounded-xl bg-[#F9F5F2] input-bg" type="text" placeholder="Enter your phone number">
                </div>
            </div>
            <div class="px-10 mt-10">
                <button class="w-full text-white bg-[#E85D26] rounded-xl p-3">Submit Feedback</button>
            </div>
            <p class="text-sm text-center mt-10 text-[#565656]">&copy; powered by C-R-P</p>
        </form>
    </div>
</section>