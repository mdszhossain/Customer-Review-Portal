<%- layout("./layout/boilerplate.ejs") %>
<section>
    <div class="h-screen bg-[#341C13] flex justify-center items-center">
        <form action="/crp/signin" method="GET" class="auth-outerform w-100 bg-[#FFFAF7] rounded-xl">
            <div>
                <div class="text-[#E85D26] font-bold text-center mt-5 text-xl"><i class="fa-brands fa-yelp"></i>C-R-P</div>
